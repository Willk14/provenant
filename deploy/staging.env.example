# Staging: production-shaped, demo data only (never client data). Copy into the host's secret store; never commit
# real values. Each line is read by the API and the worker unless noted.

# Database: the app connects as the non-owner role so row-level security applies.
DATABASE_URL=postgresql+psycopg://provenant_app:CHANGE_ME@db.example.internal:5432/provenant
# Migrations only (release step, as the table owner):
#   DATABASE_URL=postgresql+psycopg://provenant:CHANGE_ME@db.example.internal:5432/provenant
#   PROVENANT_APP_ROLE=provenant_app

# Sign-in: Supabase Auth (recommended), or any OIDC provider whose tokens carry the firm and roles. Dev auth off.
PROVENANT_DEV_AUTH=0
# Supabase: the project URL. Access tokens are checked against its public keys; firm and roles come from app_metadata.
#   PROVENANT_SUPABASE_URL=https://<project-ref>.supabase.co
#   PROVENANT_SUPABASE_SECRET_KEY=sb_secret_...   # server only: sends invitations. Never give it to the web app.
#   PROVENANT_APP_URL=https://app.example.com      # links in invitations and notification emails
# Or another OIDC provider:
PROVENANT_JWT_ISSUER=https://auth.example.com/
PROVENANT_JWT_AUDIENCE=provenant-staging
PROVENANT_JWKS_URL=https://auth.example.com/.well-known/jwks.json
PROVENANT_JWT_TENANT_CLAIM=tenant_id
PROVENANT_JWT_ROLES_CLAIM=roles

# Files: an S3-compatible bucket (container disks do not survive restarts).
PROVENANT_STORAGE=s3
PROVENANT_S3_BUCKET=provenant-staging
PROVENANT_S3_PREFIX=blobs
PROVENANT_S3_ENDPOINT=https://s3.example.com   # leave empty for AWS S3
PROVENANT_S3_REGION=auto
AWS_ACCESS_KEY_ID=CHANGE_ME
AWS_SECRET_ACCESS_KEY=CHANGE_ME
PROVENANT_CACHE_DIR=/data/cache

# Extraction: the deterministic label extractor by default; claude needs ANTHROPIC_API_KEY from the secret store.
PROVENANT_EXTRACTOR=labels
PROVENANT_INLINE_WORKER=0   # run the worker as its own process: python -m provenant.worker

# Work notifications (ADR 0017): your firm's SMTP server. Without it, notifications are recorded as skipped.
#   PROVENANT_SMTP_HOST=smtp.example.com
#   PROVENANT_SMTP_PORT=587                        # 465 for TLS throughout, otherwise STARTTLS
#   PROVENANT_SMTP_USER=provenant@example.com
#   PROVENANT_SMTP_PASSWORD=CHANGE_ME
#   PROVENANT_SMTP_FROM=Provenant <provenant@example.com>

# Documents by email (ADR 0017): an inbound mail service posts raw messages to /inbound/email with this token.
#   PROVENANT_INBOUND_DOMAIN=in.example.com
#   PROVENANT_INBOUND_SECRET=CHANGE_ME             # signs each firm's address; changing it changes every address
#   PROVENANT_INBOUND_TOKEN=CHANGE_ME              # the mail service sends it as X-Provenant-Inbound-Token

# Web app (build arguments, not runtime): where the Next server forwards /api, and Supabase sign-in.
#   PROVENANT_API_URL=http://provenant-api.internal:8000
#   NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
#   NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...   # the publishable key only: it is sent to browsers
