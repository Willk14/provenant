# Staging: production-shaped, demo data only (never client data). Copy into the host's secret store; never commit
# real values. Each line is read by the API and the worker unless noted.

# Database: the app connects as the non-owner role so row-level security applies.
DATABASE_URL=postgresql+psycopg://provenant_app:CHANGE_ME@db.example.internal:5432/provenant
# Migrations only (release step, as the table owner):
#   DATABASE_URL=postgresql+psycopg://provenant:CHANGE_ME@db.example.internal:5432/provenant
#   PROVENANT_APP_ROLE=provenant_app

# Sign-in: an OIDC provider whose tokens carry the firm and the user's roles. Dev auth must be off.
PROVENANT_DEV_AUTH=0
PROVENANT_JWT_ISSUER=https://auth.example.com/
PROVENANT_JWT_AUDIENCE=provenant-staging
PROVENANT_JWKS_URL=https://auth.example.com/.well-known/jwks.json
PROVENANT_JWT_TENANT_CLAIM=tenant_id
PROVENANT_JWT_ROLES_CLAIM=roles

# Files: an S3-compatible bucket (container disks do not survive restarts).
PROVENANT_STORAGE=s3
PROVENANT_S3_BUCKET=provenant-staging
PROVENANT_S3_PREFIX=blobs
PROVENANT_S3_ENDPOINT=https://s3.example.com   # leave empty for AWS S3
PROVENANT_S3_REGION=auto
AWS_ACCESS_KEY_ID=CHANGE_ME
AWS_SECRET_ACCESS_KEY=CHANGE_ME
PROVENANT_CACHE_DIR=/data/cache

# Extraction: the deterministic label extractor by default; claude needs ANTHROPIC_API_KEY from the secret store.
PROVENANT_EXTRACTOR=labels
PROVENANT_INLINE_WORKER=0   # run the worker as its own process: python -m provenant.worker

# Web app (build argument, not runtime): where the Next server forwards /api.
#   PROVENANT_API_URL=http://provenant-api.internal:8000
