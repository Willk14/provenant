# Real sign-in for the web app (public values only: anything NEXT_PUBLIC_ is sent to the browser).
# Copy to .env.local, fill in, and restart `npm run dev`. Without them the app uses the demo people.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
